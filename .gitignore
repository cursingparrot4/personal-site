# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# deploy
.vercel

# secrets — never commit these
.DS_Store
*.pem
recovery-codes.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# browser-automation artifacts (traces, videos, screenshots)
/.playwright/
/.playwright-cli/
/test-results/
/playwright-report/

# local agent config + skills (incl. .claude/skills/playwright-cli)
.claude/

# Working resume files at the repo root. Only /*.pdf — one level — so the
# deployed copy at public/resume.pdf is still committed. Don't broaden this
# to *.pdf or the site's resume link silently 404s in production.
/*.pdf

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea/
